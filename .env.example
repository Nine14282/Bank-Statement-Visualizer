# Settings for the ledger scripts. setup.sh copies this file to .env if there is none.
# .env is secret and git-ignored: never commit it. Every value here is optional.
# Format: KEY=value, one per line. No inline comments. Real environment variables win.

# --- Statement PDF passwords -----------------------------------------------------
# Leave blank to be asked (typed, hidden) whenever a PDF is password-protected.
# Fill them in for runs with nobody to type them (the real-time Gmail listener), or tick "Remember" on the
# setup page (./run.sh --setup). KBank statements are the files named STM_...; each file tries its
# own bank's password first, then the others. Each bank's setting is listed in the BANKS registry
# in workspace/banks/.
# Krungthai (KTB) statements. (STATEMENT_PW, the old name, is still read if KTB_PW is blank.)
KTB_PW=
# Kasikorn (KBank) statements.
KBANK_PW=

# --- Gmail auto-fetch (only for ./gmail.sh; see README "Option 2") ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
# Real time (./gmail.sh --listen, also started by the app window; README "Real time: Gmail push"): Pub/Sub topic and pull
# subscription IDs (needs GOOGLE_PROJECT_ID too). Setting GMAIL_TOPIC adds the Pub/Sub permission to the
# Gmail sign-in, so the next run asks you to sign in again. Blank = off.
GMAIL_TOPIC=
GMAIL_SUBSCRIPTION=

# --- Optional categories -------------------------------------------------------
# Account numbers exactly as they appear in the transaction detail text. They turn
# otherwise-plain transfers into "Cash withdrawal/deposit", "Lent out/Loan repaid to
# me" and "Stock investment/return". Blank = that category is off.
LEDGER_CASH_REF=
LEDGER_PEER_REF=
LEDGER_STOCK_REF=

# --- Optional account label and your name (top-bar avatar and greeting) ---------
ACCOUNT_LABEL=
ACCOUNT_HOLDER=

# --- Dashboard theme (picked on the setup page) ---------------------------------
# A theme id from web/src/lib/themes.ts: midnight (dark) or daylight (light). Blank = midnight.
THEME=
