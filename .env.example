# Settings for the ledger scripts. setup.sh copies this file to .env if there is none.
# .env is secret and git-ignored: never commit it. Every value here is optional.
# Format: KEY=value, one per line. No inline comments. Real environment variables win.

# --- Statement PDF password ------------------------------------------------------
# Leave blank to be asked (typed, hidden) whenever a PDF is password-protected.
# Fill it in for unattended runs (cron, ./gmail.sh on a schedule).
STATEMENT_PW=

# --- Gmail auto-fetch (only for ./gmail.sh; see README "Option 2") ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
# Gmail search that finds your statement emails. Blank = Krungthai's default subject, which
# matches ANY sender: anyone could email a fake statement PDF with that subject and it would be
# added to your ledger. SET THIS to your bank's real address (check an old statement email):
#   GMAIL_QUERY=from:<your bank's sender address> has:attachment filename:pdf
GMAIL_QUERY=

# --- Optional categories -------------------------------------------------------
# Account numbers exactly as they appear in the transaction detail text. They turn
# otherwise-plain transfers into "Cash withdrawal/deposit", "Lent out/Loan repaid to
# me" and "Stock investment/return". Blank = that category is off.
LEDGER_CASH_REF=
LEDGER_PEER_REF=
LEDGER_STOCK_REF=

# --- Optional sidebar label on the dashboard ------------------------------------
ACCOUNT_LABEL=
ACCOUNT_HOLDER=
