<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "program" (paste it into the SignPath project under that slug). The Windows build
     (.github/workflows/windows-build.yml) uploads StatementVisualizer.exe alone, as a zip, before Setup is made from
     it: the installed program is signed, not only its installer. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="StatementVisualizer.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
